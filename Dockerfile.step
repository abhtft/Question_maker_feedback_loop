# Use the official AWS Lambda Python base image
FROM public.ecr.aws/lambda/python:3.11

# Copy requirements.txt to the Lambda task root directory
COPY requirements.txt ${LAMBDA_TASK_ROOT}/

# Install Python dependencies in the task root
RUN pip install --upgrade pip && \
    pip install --no-cache-dir --only-binary=:all: -r requirements.txt

# Copy all application files (including backend/ and Utility/) to the task root
COPY . ${LAMBDA_TASK_ROOT}/

# Set the default CMD (this will be overridden for each Lambda function in AWS)
CMD ["backend.step_lambda.status_checker.handler"]
